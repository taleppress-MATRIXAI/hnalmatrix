generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("business")
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Business {
  id              String       @id @default(cuid())
  name            String
  industry        String
  website         String?
  phone           String?
  country         String       @default("Morocco")
  language        String       @default("ar")
  description     String?
  users           User[]
  leads           Lead[]
  bookings        Booking[]
  messages        Message[]
  subscriptions   Subscription[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Lead {
  id              String    @id @default(cuid())
  name            String
  email           String?
  phone           String?
  source          String
  status          String    @default("new")
  value           Float     @default(0)
  notes           String?
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Message {
  id              String    @id @default(cuid())
  sender          String
  content         String
  channel         String
  sentiment       String    @default("neutral")
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  createdAt       DateTime  @default(now())
}

model Booking {
  id              String    @id @default(cuid())
  customerName    String
  service         String
  date            DateTime
  phone           String?
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
}

model Subscription {
  id              String    @id @default(cuid())
  plan            String
  amount          Float
  status          String    @default("active")
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
